# Server
GATEWAY_PORT=8000

# Keycloak (JWT validation)
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=game-cellar

# Keycloak Admin (user registration)
KEYCLOAK_CLIENT_ID=game-cellar-client
GATEWAY_ADMIN_CLIENT_ID=gateway-admin
GATEWAY_ADMIN_CLIENT_SECRET=your-client-secret-here

# Rate limiting (optional overrides)
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_RECOMMENDATIONS_REQUESTS=60
RATE_LIMIT_RECOMMENDATIONS_WINDOW_SECONDS=60
